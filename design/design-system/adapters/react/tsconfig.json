{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../../site/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../site/node_modules/@types/react/jsx-runtime.d.ts"],
      "@reflower/core-ui-react": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.tsx"]
}
