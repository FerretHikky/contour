  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "reduced": {
        "$value": {
          "value": 1,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      },
      "ambient": {
        "$value": {
          "value": 1200,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
