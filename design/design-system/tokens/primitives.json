{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Established non-color primitives outside the value-based Dimension/Opacity scales in foundations.json; canonical colors live in color-primitives.json.",
  "border": {
    "style": {
      "$type": "string",
      "solid": {
        "$value": "solid"
      },
      "dashed": {
        "$value": "dashed"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Figma Typography / Font / Family primitives. All product families currently resolve to Onest.",
